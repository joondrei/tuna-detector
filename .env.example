# Template for .env  -  copy it and fill in the values:
#
#     cp .env.example .env
#
# `.env` is git-ignored, so real secrets stay on your machine. This file is the
# committed template: keep placeholders here, never real keys.

# ----------------------------------------------------------------- Airflow --
# Signs the API tokens (Airflow 3). Any long random string:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AIRFLOW__API_AUTH__JWT_SECRET=change-me-generate-a-random-string
AIRFLOW__API_AUTH__JWT_ISSUER=airflow

# Encrypts connection passwords inside the metadata database. Changing it later
# makes everything Airflow already encrypted unreadable:
#   python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
FERNET_KEY=change-me-generate-a-fernet-key

# UID the Airflow containers run as. On Linux use your own (`id -u`) so the
# bind-mounted ./logs and ./plugins stay writable for you.
AIRFLOW_UID=50000

# GID of the host's `docker` group; the scheduler needs it to open the Docker
# socket and start tuning containers. Numeric id only:
#   getent group docker | cut -d: -f3
DOCKER_GID=952

# Web user created once by airflow-init.
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=change-me

# -------------------------------------------------------- Optuna / Postgres --
# The scripts build the study DSN from these, and the postgres container creates
# the database and role on its first start (existing volume: ignored).
OPTUNA_USER=optuna
OPTUNA_PASSWORD=change-me
OPTUNA_DB=optuna_db

# Only needed when the scripts run on the host instead of in a container:
# OPTUNA_HOST=localhost
# OPTUNA_PORT=5434

# ------------------------------------------------------------------ MLflow ---
# Experiment tracking. With DATABRICKS_HOST set, make_tracker() falls back to
# "databricks" when MLFLOW_TRACKING_URI is empty; set USE_MLFLOW = False in
# scripts/tune_trial.py to skip tracking entirely.
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=dapi-00000000000000000000000000000000

# Where experiments live in the workspace; the study name is appended to it.
# MLFLOW_EXPERIMENT_ROOT is accepted as an alias.
MLFLOW_DATABRICKS_ROOT=/Shared/experiments/ai-detection

# Set this instead of the Databricks pair to use any MLflow server:
# MLFLOW_TRACKING_URI=http://localhost:5000
